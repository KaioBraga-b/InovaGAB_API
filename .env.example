# ==============================================================================
# InovaGAB API — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores conforme o ambiente
# ==============================================================================

# --- MongoDB ---
MONGO_DATABASE=inovagab_db
MONGO_USERNAME=root
MONGO_PASSWORD=secret
MONGO_PORT=27017

# --- Mongo Express (Admin UI) ---
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=admin123
MONGO_EXPRESS_PORT=8081

# --- API Spring Boot ---
API_PORT=8080
SPRING_PROFILES_ACTIVE=production

# --- JWT ---
JWT_SECRET=9a3f8b1c4e7d2a5f8e0b3c6d9a1f4e7d2a5f8e0b3c6d9a1f4e7d2a5f8e0b3c6d
JWT_EXPIRATION_MS=86400000

# --- JVM ---
JAVA_OPTS=-Xms256m -Xmx512m
