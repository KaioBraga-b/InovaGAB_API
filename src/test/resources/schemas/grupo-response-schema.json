{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GrupoResponse",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "hashId": { "type": "string" },
    "nome": { "type": "string" },
    "departamento": { "type": ["string", "null"] },
    "descricao": { "type": ["string", "null"] },
    "gestorId": { "type": "string" },
    "gestorEmail": { "type": ["string", "null"] },
    "dataCriacao": { "type": ["string", "null"] },
    "membros": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "nome": { "type": ["string", "null"] },
          "role": { "type": ["string", "null"] }
        },
        "required": ["email"]
      }
    },
    "totalMembros": { "type": "integer" }
  },
  "required": ["id", "hashId", "nome", "gestorId"]
}