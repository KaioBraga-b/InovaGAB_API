  "title": "UserProfile",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "nome": { "type": "string" },
    "sobrenome": { "type": ["string", "null"] },
    "email": { "type": "string" },
    "role": { "type": "string" },
    "unidade": { "type": ["string", "null"] },
    "groupId": { "type": ["string", "null"] }
